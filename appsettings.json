{
  "miner": {
    "executable": "miner/keryx-miner.exe",
    "argumentsTemplate": "--mining-address {wallet} --keryxd-address {node} --port {port} --cuda-device {gpu} {tier}",
    "stopTimeoutSeconds": 8
  },
  "node": {
    "executable": "keryxd/keryxd.exe",
    "dataDirectory": "../KeryxData"
  },
  "tiers": [
    { "name": "Very Light (8 Go+)", "minVramGb": 8, "argument": "--very-light" },
    { "name": "Light (12 Go+)", "minVramGb": 12, "argument": "--light" },
    { "name": "Standard (16 Go+)", "minVramGb": 16, "argument": "" },
    { "name": "High (24 Go+)", "minVramGb": 24, "argument": "--high" },
    { "name": "Very High (30 Go+)", "minVramGb": 30, "argument": "--very-high" }
  ]
}
