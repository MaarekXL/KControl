<Window x:Class="KeryxControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keryx Control" Width="1260" Height="860" MinWidth="1040" MinHeight="720"
        Background="#050806" Foreground="#E9FFF0" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" UseLayoutRounding="True" Closing="Window_Closing">
 <Window.Resources>
  <SolidColorBrush x:Key="Green" Color="#22E66D"/>
  <SolidColorBrush x:Key="Panel" Color="#0B110D"/>
  <SolidColorBrush x:Key="Line" Color="#1B3423"/>
  <SolidColorBrush x:Key="Muted" Color="#789184"/>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E9FFF0"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Title" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Green}"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="17"/><Setter Property="Margin" Value="5"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#070B08"/><Setter Property="Foreground" Value="#E9FFF0"/><Setter Property="CaretBrush" Value="{StaticResource Green}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,4,0,10"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Background" Value="#F1F1F1"/><Setter Property="Foreground" Value="#102016"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,4,0,10"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E9FFF0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style x:Key="Primary" TargetType="Button"><Setter Property="Background" Value="{StaticResource Green}"/><Setter Property="Foreground" Value="#041006"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="15,10"/><Setter Property="Margin" Value="0,3,0,7"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource Primary}"><Setter Property="Background" Value="#132219"/><Setter Property="Foreground" Value="#BEE8CB"/><Setter Property="BorderBrush" Value="#294B34"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource Primary}"><Setter Property="Background" Value="#3A171A"/><Setter Property="Foreground" Value="#FF9CA4"/><Setter Property="BorderBrush" Value="#6A292F"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style x:Key="LogLine" TargetType="TextBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,1"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/><Setter Property="FontSize" Value="12"/><Setter Property="SelectionBrush" Value="#326C45"/></Style>
 </Window.Resources>

 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>

  <Border Background="#070C08" BorderBrush="#17301E" BorderThickness="0,0,0,1">
   <Grid Margin="24,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Border Width="42" Height="42" CornerRadius="10" Background="#102B18" BorderBrush="{StaticResource Green}" BorderThickness="1"><TextBlock Text="K" Foreground="{StaticResource Green}" FontSize="23" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <StackPanel Margin="13,0,0,0" VerticalAlignment="Center"><TextBlock Text="KERYX CONTROL" FontSize="22" FontWeight="Bold"/><TextBlock Text="{DynamicResource AppSubtitle}" Style="{StaticResource Caption}" Foreground="#5EA977"/></StackPanel>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <ComboBox x:Name="LanguageCombo" Width="70" Margin="0,0,12,0" Padding="7,5" SelectionChanged="Language_SelectionChanged"><ComboBoxItem Content="FR" Tag="fr"/><ComboBoxItem Content="EN" Tag="en"/></ComboBox>
     <Border Background="#0D1D12" BorderBrush="#214E2D" BorderThickness="1" CornerRadius="20" Padding="14,7"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{Binding StatusDot}" Margin="0,0,8,0"/><TextBlock Text="{Binding Status}" Foreground="{Binding StatusForeground}" FontWeight="SemiBold"/></StackPanel></Border>
    </StackPanel>
   </Grid>
  </Border>

  <Grid Grid.Row="1" Margin="19,14,19,9">
   <Grid.RowDefinitions><RowDefinition Height="102"/><RowDefinition Height="345"/><RowDefinition Height="6"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <UniformGrid Columns="5">
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource Hashrate}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Hashrate}" FontSize="23" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="{Binding Uptime}" Style="{StaticResource Caption}" Margin="0,3,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource Power}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Power}" FontSize="23" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource Temperature}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Temperature}" FontSize="23" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource Efficiency}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Efficiency}" FontSize="23" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource Blocks}" Style="{StaticResource Caption}"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="{Binding Accepted}" Foreground="{StaticResource Green}" FontSize="23" FontWeight="SemiBold"/><TextBlock Text=" / " Foreground="{StaticResource Muted}" FontSize="23"/><TextBlock Text="{Binding Rejected}" Foreground="#FF7B82" FontSize="23" FontWeight="SemiBold"/></StackPanel></StackPanel></Border>
   </UniformGrid>

   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.75*"/><ColumnDefinition Width="1.02*"/><ColumnDefinition Width="0.72*"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="112"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource MinerConfiguration}" Style="{StaticResource Title}"/><TextBlock Grid.Column="1" Text="{DynamicResource AutoPerGpu}" Style="{StaticResource Caption}"/></Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <ItemsControl ItemsSource="{Binding Gpus}">
        <ItemsControl.ItemTemplate><DataTemplate>
         <Border BorderBrush="#17301E" BorderThickness="0,0,0,1" Padding="0,5">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
           <StackPanel VerticalAlignment="Center"><CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}" IsEnabled="{Binding DataContext.ConfigurationEnabled, RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="SemiBold"/><TextBlock Text="{Binding DetailText}" Style="{StaticResource Caption}" Margin="22,3,0,0"/></StackPanel>
           <ComboBox Grid.Column="1" ItemsSource="{Binding DataContext.TierOptions, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding SelectedTier}" DisplayMemberPath="DisplayName" IsEnabled="{Binding DataContext.ConfigurationEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Margin="10,0,0,0"/>
          </Grid>
         </Border>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </ScrollViewer>
      <Grid Grid.Row="2" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,12,0"><TextBlock Text="{DynamicResource KeryxAddress}" Style="{StaticResource Caption}"/><TextBox Text="{Binding Wallet, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ConfigurationEnabled}"/><TextBlock Text="{DynamicResource AddressHint}" Style="{StaticResource Caption}" Foreground="#496955"/></StackPanel>
       <StackPanel Grid.Column="1" Margin="12,0,0,0">
        <TextBlock Text="{DynamicResource MiningMode}" Style="{StaticResource Caption}"/>
        <ComboBox ItemsSource="{Binding MiningModeOptions}" SelectedItem="{Binding SelectedMiningMode}" DisplayMemberPath="DisplayName" IsEnabled="{Binding ConnectionConfigurationEnabled}"/>
        <StackPanel Visibility="{Binding IsSoloMode, Converter={StaticResource BoolVisibility}}">
         <TextBlock Text="{DynamicResource LocalNodePort}" Style="{StaticResource Caption}"/>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions><TextBox Text="{Binding NodeAddress, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ConnectionConfigurationEnabled}"/><TextBox Grid.Column="1" Margin="8,4,0,10" Text="{Binding NodePort}" IsEnabled="{Binding ConnectionConfigurationEnabled}"/></Grid>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="{DynamicResource StartNode}" Command="{Binding StartNodeCommand}" Style="{StaticResource Secondary}" Padding="5,7" Margin="0,0,4,0" FontSize="10"/><Button Grid.Column="1" Content="{DynamicResource StopNode}" Command="{Binding StopNodeCommand}" Style="{StaticResource Secondary}" Padding="5,7" Margin="4,0,0,0" FontSize="10"/></Grid>
        </StackPanel>
        <StackPanel Visibility="{Binding IsPoolMode, Converter={StaticResource BoolVisibility}}">
         <TextBlock Text="{DynamicResource PoolAddress}" Style="{StaticResource Caption}"/>
         <TextBox Text="{Binding PoolAddress, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ConnectionConfigurationEnabled}"/>
        </StackPanel>
        <TextBlock Text="{Binding NodeSyncText}" Foreground="#79D895" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0" TextWrapping="Wrap"/>
       </StackPanel>
      </Grid>
     </Grid>
    </Border>

    <Border Grid.Column="1" Style="{StaticResource Card}">
     <StackPanel><TextBlock Text="{DynamicResource PowerControl}" Style="{StaticResource Title}"/><TextBlock Text="{DynamicResource PowerGpu}" Style="{StaticResource Caption}"/><ComboBox ItemsSource="{Binding Gpus}" SelectedItem="{Binding SelectedPowerGpu}" DisplayMemberPath="DisplayName"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource PowerLimit}" Style="{StaticResource Caption}"/><TextBlock Grid.Column="1" Text="{Binding PowerLimit, StringFormat={}{0:0} W}" Foreground="{StaticResource Green}" FontWeight="Bold"/></Grid>
      <Slider Minimum="{Binding PowerMinimum}" Maximum="{Binding PowerMaximum}" Value="{Binding PowerLimit}" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,11,0,7"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Eco}" Style="{StaticResource Caption}"/><TextBlock Grid.Column="1" Text="{DynamicResource Performance}" Style="{StaticResource Caption}" HorizontalAlignment="Right"/></Grid>
      <Button Content="{DynamicResource ApplyLimit}" Command="{Binding ApplyPowerCommand}" Style="{StaticResource Secondary}" Margin="0,14,0,0"/>
      <Separator Background="{StaticResource Line}" Margin="0,10"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource GpuLoad}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding SelectedPowerGpu.Utilization}" FontSize="16" FontWeight="SemiBold" Margin="0,4"/><TextBlock Text="{Binding SelectedPowerGpu.Fan}" Style="{StaticResource Caption}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource Memory}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding SelectedPowerGpu.Memory}" FontSize="12" FontWeight="SemiBold" Margin="0,6"/><TextBlock Text="{Binding SelectedPowerGpu.Hashrate}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding SelectedPowerGpu.MemoryTemperatureDisplay}" Style="{StaticResource Caption}" Margin="0,3,0,0"/></StackPanel></Grid>
     </StackPanel>
    </Border>

    <Border Grid.Column="2" Style="{StaticResource Card}">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel><TextBlock Text="{DynamicResource Commands}" Style="{StaticResource Title}"/><Button Content="{Binding StartButtonText}" Command="{Binding StartCommand}" Style="{StaticResource Primary}"/><Button Content="{DynamicResource StopMiner}" Command="{Binding StopCommand}" Style="{StaticResource Danger}"/><Button Content="{DynamicResource Refresh}" Command="{Binding RefreshCommand}" Style="{StaticResource Secondary}"/><Button Content="{DynamicResource OpenAuthorization}" Click="OpenEscrow_Click" Style="{StaticResource Secondary}" Visibility="{Binding IsSoloMode, Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{DynamicResource PoolManagedServices}" Visibility="{Binding IsPoolMode, Converter={StaticResource BoolVisibility}}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextAlignment="Center" Margin="2,4"/><TextBlock Text="{Binding ModelStatusText}" Foreground="#79D895" TextWrapping="Wrap" FontSize="11" HorizontalAlignment="Center" Margin="0,5"/><TextBlock Text="{Binding ServiceStatusText}" Foreground="#F2C66D" TextWrapping="Wrap" FontSize="11" HorizontalAlignment="Center" Margin="0,2"/><ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding ModelProgress, Mode=OneWay}" Visibility="{Binding ModelProgressVisible, Converter={StaticResource BoolVisibility}}" Foreground="{StaticResource Green}" Background="#132219"/>
       <Separator Background="{StaticResource Line}" Margin="0,10"/>
       <Expander IsExpanded="True" Foreground="#E9FFF0">
        <Expander.Header><StackPanel><TextBlock Text="{DynamicResource TurzxScreen}" Style="{StaticResource Title}" Margin="0,0,0,2"/><TextBlock Text="{Binding TurzxStatusText}" Foreground="{Binding TurzxStatusForeground}" FontSize="10" TextWrapping="Wrap"/></StackPanel></Expander.Header>
        <StackPanel Margin="0,8,0,0">
         <CheckBox Content="{DynamicResource TurzxEnable}" IsChecked="{Binding TurzxEnabled}" Margin="0,0,0,8"/>
         <TextBlock Text="{DynamicResource TurzxModel}" Style="{StaticResource Caption}"/>
         <ComboBox ItemsSource="{Binding TurzxModelOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding TurzxModelSetting}" IsEnabled="{Binding TurzxEnabled}" Margin="0,4,0,8"/>
         <Grid IsEnabled="{Binding TurzxEnabled}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource TurzxBrightness}" Style="{StaticResource Caption}"/><TextBlock Grid.Column="1" Text="{Binding TurzxBrightness, StringFormat={}{0}%}" Foreground="{StaticResource Green}" FontWeight="Bold"/></Grid>
         <Slider Minimum="10" Maximum="100" Value="{Binding TurzxBrightness}" TickFrequency="10" IsSnapToTickEnabled="True" IsEnabled="{Binding TurzxEnabled}" Margin="0,4,0,7"/>
         <TextBlock Text="{DynamicResource TurzxPort}" Style="{StaticResource Caption}"/>
         <TextBox Text="{Binding TurzxPortSetting, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding TurzxEnabled}" Margin="0,4,0,5"/>
         <Button Content="{DynamicResource TurzxReconnect}" Command="{Binding ReconnectTurzxCommand}" Style="{StaticResource Secondary}" Padding="5,7" IsEnabled="{Binding TurzxEnabled}"/>
        </StackPanel>
       </Expander>
      </StackPanel>
     </ScrollViewer>
    </Border>
   </Grid>

   <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows"/>

   <Border Grid.Row="3" Style="{StaticResource Card}" Margin="5,5,5,5" Padding="0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border Background="#0E1711" CornerRadius="14,14,0,0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource ActivityLog}" Style="{StaticResource Title}" Margin="0" VerticalAlignment="Center"/><Button Grid.Column="1" Content="{DynamicResource CopyLog}" Click="CopyLog_Click" Style="{StaticResource Secondary}" Padding="10,5" Margin="0,0,10,0"/><TextBlock Grid.Column="2" Text="{Binding LogPauseText}" Foreground="#FF8C92" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="{Binding IsLogPaused, Converter={StaticResource BoolVisibility}}"/><Button Grid.Column="3" Content="{DynamicResource ResumeLive}" Click="ResumeLog_Click" Style="{StaticResource Secondary}" Padding="10,5" Margin="0" Visibility="{Binding IsLogPaused, Converter={StaticResource BoolVisibility}}"/></Grid>
     </Border>
     <ListBox x:Name="LogList" Grid.Row="1" ItemsSource="{Binding Logs}" Background="#060A07" BorderThickness="0" Padding="12,8" SelectionMode="Extended" PreviewMouseWheel="LogList_PreviewMouseWheel" ScrollViewer.ScrollChanged="LogList_ScrollChanged" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Focusable" Value="False"/></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><TextBox Text="{Binding DisplayText, Mode=OneWay}" Foreground="{Binding Foreground}" Style="{StaticResource LogLine}"/></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </Grid>
   </Border>
  </Grid>

  <Border Grid.Row="2" Background="#070C08" BorderBrush="#122319" BorderThickness="0,1,0,0"><Grid Margin="23,0"><TextBlock Text="{DynamicResource CommunityFrontend}" Style="{StaticResource Caption}" VerticalAlignment="Center"/><TextBlock Text="v0.8.0 TURZX  •  Keryx Miner 0.5.4-PoM  •  keryxd 1.6.0-PoM" HorizontalAlignment="Right" Style="{StaticResource Caption}" VerticalAlignment="Center"/></Grid></Border>
 </Grid>
</Window>
