<Window x:Class="KeryxControl.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Keryx Control" Width="1160" Height="790" MinWidth="960" MinHeight="670" Background="#050806" Foreground="#E9FFF0" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" UseLayoutRounding="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Green" Color="#22E66D"/><SolidColorBrush x:Key="Panel" Color="#0B110D"/><SolidColorBrush x:Key="Line" Color="#1B3423"/><SolidColorBrush x:Key="Muted" Color="#789184"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E9FFF0"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Title" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Green}"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="5"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#070B08"/><Setter Property="Foreground" Value="#E9FFF0"/><Setter Property="CaretBrush" Value="{StaticResource Green}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="11,9"/><Setter Property="Margin" Value="0,5,0,13"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Background" Value="#070B08"/><Setter Property="Foreground" Value="#102016"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Padding" Value="9,7"/><Setter Property="Margin" Value="0,5,0,13"/></Style>
  <Style x:Key="Primary" TargetType="Button"><Setter Property="Background" Value="{StaticResource Green}"/><Setter Property="Foreground" Value="#041006"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="17,11"/><Setter Property="Margin" Value="0,3,0,8"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource Primary}"><Setter Property="Background" Value="#132219"/><Setter Property="Foreground" Value="#BEE8CB"/><Setter Property="BorderBrush" Value="#294B34"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource Primary}"><Setter Property="Background" Value="#3A171A"/><Setter Property="Foreground" Value="#FF9CA4"/><Setter Property="BorderBrush" Value="#6A292F"/><Setter Property="BorderThickness" Value="1"/></Style>
 </Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
  <Border Background="#070C08" BorderBrush="#17301E" BorderThickness="0,0,0,1"><Grid Margin="24,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="42" Height="42" CornerRadius="10" Background="#102B18" BorderBrush="{StaticResource Green}" BorderThickness="1"><TextBlock Text="K" Foreground="{StaticResource Green}" FontSize="23" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="13,0,0,0" VerticalAlignment="Center"><TextBlock Text="KERYX CONTROL" FontSize="22" FontWeight="Bold"/><TextBlock Text="{DynamicResource AppSubtitle}" Style="{StaticResource Caption}" Foreground="#5EA977"/></StackPanel></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><ComboBox Width="70" Margin="0,0,12,0" Padding="7,5" SelectedIndex="0" SelectionChanged="Language_SelectionChanged"><ComboBoxItem Content="FR" Tag="fr"/><ComboBoxItem Content="EN" Tag="en"/></ComboBox><Border Background="#0D1D12" BorderBrush="#214E2D" BorderThickness="1" CornerRadius="20" Padding="14,7"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{StaticResource Green}" Margin="0,0,8,0"/><TextBlock Text="{Binding Status}" Foreground="#8BFFAE" FontWeight="SemiBold"/></StackPanel></Border></StackPanel></Grid></Border>
  <Grid Grid.Row="1" Margin="19,15,19,10"><Grid.RowDefinitions><RowDefinition Height="102"/><RowDefinition Height="292"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <UniformGrid Columns="5">
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource Hashrate}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Hashrate}" FontSize="23" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource Power}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Power}" FontSize="23" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource Temperature}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Temperature}" FontSize="23" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource Efficiency}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Efficiency}" FontSize="23" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource Shares}" Style="{StaticResource Caption}"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="{Binding Accepted}" Foreground="{StaticResource Green}" FontSize="23" FontWeight="SemiBold"/><TextBlock Text=" / " Foreground="{StaticResource Muted}" FontSize="23"/><TextBlock Text="{Binding Rejected}" Foreground="#FF7B82" FontSize="23" FontWeight="SemiBold"/></StackPanel></StackPanel></Border>
   </UniformGrid>
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="0.72*"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="{DynamicResource MinerConfiguration}" Style="{StaticResource Title}"/><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="{DynamicResource GraphicsCard}" Style="{StaticResource Caption}"/><ComboBox ItemsSource="{Binding Gpus}" SelectedItem="{Binding SelectedGpu}" DisplayMemberPath="DisplayName"/><TextBlock Text="{DynamicResource KeryxAddress}" Style="{StaticResource Caption}"/><TextBox Text="{Binding Wallet, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{DynamicResource AddressHint}" Style="{StaticResource Caption}" Foreground="#496955"/></StackPanel><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="{DynamicResource ModelProfile}" Style="{StaticResource Caption}"/><ComboBox ItemsSource="{Binding Tiers}" SelectedItem="{Binding SelectedTier}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="#102016" FontWeight="SemiBold"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="{DynamicResource LocalNodePort}" Style="{StaticResource Caption}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions><TextBox Text="{Binding NodeAddress, UpdateSourceTrigger=PropertyChanged}"/><TextBox Grid.Column="1" Margin="8,5,0,13" Text="{Binding NodePort}"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="{DynamicResource StartNode}" Command="{Binding StartNodeCommand}" Style="{StaticResource Secondary}" Padding="5,7" Margin="0,0,4,0" FontSize="10"/><Button Grid.Column="1" Content="{DynamicResource StopNode}" Command="{Binding StopNodeCommand}" Style="{StaticResource Secondary}" Padding="5,7" Margin="4,0,0,0" FontSize="10"/></Grid></StackPanel></Grid></Grid></Border>
    <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource PowerControl}" Style="{StaticResource Title}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource PowerLimit}" Style="{StaticResource Caption}"/><TextBlock Grid.Column="1" Text="{Binding PowerLimit, StringFormat={}{0:0} W}" Foreground="{StaticResource Green}" FontWeight="Bold"/></Grid><Slider Minimum="{Binding PowerMinimum}" Maximum="{Binding PowerMaximum}" Value="{Binding PowerLimit}" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,12,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Eco}" Style="{StaticResource Caption}"/><TextBlock Grid.Column="1" Text="{DynamicResource Performance}" Style="{StaticResource Caption}" HorizontalAlignment="Right"/></Grid><Button Content="{DynamicResource ApplyLimit}" Command="{Binding ApplyPowerCommand}" Style="{StaticResource Secondary}" Margin="0,18,0,0"/><Separator Background="{StaticResource Line}" Margin="0,14"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource GpuLoad}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Utilization}" FontSize="17" FontWeight="SemiBold" Margin="0,5"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource Memory}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Memory}" FontSize="13" FontWeight="SemiBold" Margin="0,7"/></StackPanel></Grid></StackPanel></Border>
    <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource Commands}" Style="{StaticResource Title}"/><Button Content="{DynamicResource StartMiner}" Command="{Binding StartCommand}" Style="{StaticResource Primary}"/><Button Content="{DynamicResource StopMiner}" Command="{Binding StopCommand}" Style="{StaticResource Danger}"/><Button Content="{DynamicResource Refresh}" Command="{Binding RefreshCommand}" Style="{StaticResource Secondary}"/><Button Content="{DynamicResource OpenAuthorization}" Click="OpenEscrow_Click" Style="{StaticResource Secondary}"/></StackPanel></Border>
   </Grid>
   <Border Grid.Row="2" Style="{StaticResource Card}" Margin="5,8,5,5" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="#0E1711" CornerRadius="14,14,0,0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"><Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource ActivityLog}" Style="{StaticResource Title}" Margin="0" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{DynamicResource RealtimeOutput}" Style="{StaticResource Caption}" VerticalAlignment="Center"/></Grid></Border><TextBox x:Name="LogTextBox" Grid.Row="1" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#060A07" Foreground="#A6CBB1" FontFamily="Cascadia Mono, Consolas" FontSize="12" BorderThickness="0" Padding="12" Margin="0" TextChanged="LogTextBox_TextChanged"/></Grid></Border>
  </Grid>
  <Border Grid.Row="2" Background="#070C08" BorderBrush="#122319" BorderThickness="0,1,0,0"><Grid Margin="23,0"><TextBlock Text="{DynamicResource CommunityFrontend}" Style="{StaticResource Caption}" VerticalAlignment="Center"/><TextBlock Text="RTX 4000 / RTX 5000" HorizontalAlignment="Right" Style="{StaticResource Caption}" VerticalAlignment="Center"/></Grid></Border>
 </Grid>
</Window>
