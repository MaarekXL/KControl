<Window x:Class="KeryxControl.EscrowWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource AuthorizationWindowTitle}" Width="720" Height="500" ResizeMode="NoResize" Background="#050806" Foreground="#E9FFF0" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E9FFF0"/></Style>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#789184"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#070B08"/><Setter Property="Foreground" Value="#D8FFE4"/><Setter Property="CaretBrush" Value="#22E66D"/><Setter Property="BorderBrush" Value="#1B3423"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="11,9"/><Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#132219"/><Setter Property="Foreground" Value="#BEE8CB"/><Setter Property="BorderBrush" Value="#294B34"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="15,9"/><Setter Property="Margin" Value="5"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style x:Key="Primary" TargetType="Button"><Setter Property="Background" Value="#22E66D"/><Setter Property="Foreground" Value="#041006"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="15,10"/><Setter Property="Margin" Value="5"/></Style>
 </Window.Resources>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="{DynamicResource MinerAuthorization}" Foreground="#22E66D" FontSize="19" FontWeight="Bold"/><TextBlock Text="{DynamicResource EscrowHelp}" Foreground="#789184" TextWrapping="Wrap" Margin="0,8,0,20" LineHeight="18"/></StackPanel>
  <TextBlock Grid.Row="1" Text="{DynamicResource EscrowKey}" Style="{StaticResource Label}"/>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding EscrowPublicKey, Mode=OneWay}" IsReadOnly="True" VerticalContentAlignment="Center"/><Button Grid.Column="1" Content="{DynamicResource CopyKey}" Command="{Binding CopyEscrowKeyCommand}" Margin="10,0,0,0"/></Grid>
  <TextBlock Grid.Row="3" Text="{DynamicResource EscrowCertificate}" Style="{StaticResource Label}" Margin="0,20,0,6"/>
  <TextBox Grid.Row="4" Text="{Binding EscrowCertificate, UpdateSourceTrigger=PropertyChanged}" Height="76" TextWrapping="Wrap" AcceptsReturn="True"/>
  <StackPanel Grid.Row="5"><StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="-5,10,0,0"><Button Content="{DynamicResource PasteCertificate}" Command="{Binding PasteEscrowCertCommand}"/><Button Content="{DynamicResource SaveCertificate}" Command="{Binding SaveEscrowCertCommand}" Style="{StaticResource Primary}"/></StackPanel><Border Background="#0D1D12" BorderBrush="#214E2D" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,0"><TextBlock Text="{Binding EscrowStatus}" Foreground="#8BFFAE" TextWrapping="Wrap"/></Border></StackPanel>
  <Button Grid.Row="6" Content="{DynamicResource Close}" HorizontalAlignment="Right" Width="110" Click="Close_Click"/>
 </Grid>
</Window>
